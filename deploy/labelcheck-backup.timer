# Nightly backup (PRD §8). Install alongside labelcheck.service:
#   cp deploy/labelcheck-backup.{service,timer} /etc/systemd/system/
#   systemctl enable --now labelcheck-backup.timer
[Unit]
Description=Nightly off-box backup of the label store

[Timer]
# 03:20 UTC, after the daily vision call cap resets and well clear of the
# working day. Randomised so several hosts do not hit the backup target at once.
OnCalendar=*-*-* 03:20:00 UTC
RandomizedDelaySec=600
# A box that was off overnight still gets its backup rather than skipping a day.
Persistent=true

[Install]
WantedBy=timers.target
